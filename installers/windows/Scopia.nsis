; Scopia VST3 - Windows NSIS Installer

!define NAME "Scopia"
!define FILENAME "Scopia"
!define VERSION "1.0.0"
!define PUBLISHER "Aron H"
!define WEBSITE "https://www.instagram.com/aronh.official/"

RequestExecutionLevel admin

!include "MUI2.nsh"
!include "x64.nsh"

!define MUI_ABORTWARNING
!define MUI_ICON "resources/icon.ico"
!define MUI_UNICON "resources/icon.ico"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "LICENSE"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

Name "${NAME} ${VERSION}"
OutFile "Scopia-Setup.exe"
InstallDir "$PROGRAMFILES64\Common Files\VST3\${NAME}"
ShowInstDetails show

Section "MainSection" SEC01
    SetOutPath "$INSTDIR"

    File /r "build\Release\${FILENAME}.vst3\*"

    WriteUninstaller "$INSTDIR\Uninstall.exe"

    WriteRegStr HKLM "Software\${PUBLISHER}\${NAME}" "Version" "${VERSION}"
    WriteRegStr HKLM "Software\${PUBLISHER}\${NAME}" "InstallDir" "$INSTDIR"
    WriteRegStr HKLM "Software\${PUBLISHER}\${NAME}" "URL" "${WEBSITE}"

SectionEnd

Section "Uninstall"
    RMDir /r "$INSTDIR"

    DeleteRegKey HKLM "Software\${PUBLISHER}\${NAME}"

    Delete "$INSTDIR\Uninstall.exe"

SectionEnd

Function .onInit
    !insertmacro MUI_RESERVEFILE_INSTALLOPTIONAL
FunctionEnd